<?xml version="1.0"?>
<robot name="autonomous_delivery_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================================== -->
  <!-- Robot Physical Constants & Properties                                    -->
  <!-- ======================================================================== -->
  <xacro:property name="chassis_length" value="0.60" />
  <xacro:property name="chassis_width" value="0.40" />
  <xacro:property name="chassis_height" value="0.25" />
  <xacro:property name="chassis_mass" value="14.0" />

  <xacro:property name="wheel_radius" value="0.075" />
  <xacro:property name="wheel_width" value="0.040" />
  <xacro:property name="wheel_mass" value="0.8" />
  <xacro:property name="wheel_separation" value="0.40" />

  <xacro:property name="caster_radius" value="0.035" />
  <xacro:property name="caster_mass" value="0.3" />
  <xacro:property name="caster_offset_x" value="0.22" />

  <!-- ======================================================================== -->
  <!-- Materials                                                                -->
  <!-- ======================================================================== -->
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>

  <material name="accent_blue">
    <color rgba="0.1 0.45 0.85 1.0" />
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0" />
  </material>

  <material name="silver">
    <color rgba="0.8 0.8 0.8 1.0" />
  </material>

  <material name="gold">
    <color rgba="0.9 0.7 0.2 1.0" />
  </material>

  <!-- ======================================================================== -->
  <!-- Base Footprint (Ground Projection)                                       -->
  <!-- ======================================================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 ${wheel_radius}" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Base Link (Chassis Body)                                                 -->
  <!-- ======================================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 ${chassis_height / 2.0}" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="accent_blue" />
    </visual>
    <collision>
      <origin xyz="0.0 0.0 ${chassis_height / 2.0}" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 ${chassis_height / 2.0}" rpy="0.0 0.0 0.0" />
      <mass value="${chassis_mass}" />
      <inertia ixx="${(chassis_mass / 12.0) * (chassis_width*chassis_width + chassis_height*chassis_height)}"
               ixy="0.0" ixz="0.0"
               iyy="${(chassis_mass / 12.0) * (chassis_length*chassis_length + chassis_height*chassis_height)}"
               iyz="0.0"
               izz="${(chassis_mass / 12.0) * (chassis_length*chassis_length + chassis_width*chassis_width)}" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Drive Wheels (Differential Drive Axis)                                   -->
  <!-- ======================================================================== -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="${pi / 2.0} 0.0 0.0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="${pi / 2.0} 0.0 0.0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="${pi / 2.0} 0.0 0.0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="${(wheel_mass / 12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
                 ixy="0.0" ixz="0.0"
                 iyy="${(wheel_mass / 12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
                 iyz="0.0"
                 izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0.0 ${y_reflect * wheel_separation / 2.0} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 1.0 0.0" />
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y_reflect="1" />
  <xacro:drive_wheel prefix="right" y_reflect="-1" />

  <!-- ======================================================================== -->
  <!-- Dual Swivel Caster Wheels (Front and Rear for Slope Stability)           -->
  <!-- ======================================================================== -->
  <xacro:macro name="caster_wheel" params="prefix x_pos">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="silver" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="${caster_mass}" />
        <inertia ixx="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}" ixy="0.0" ixz="0.0"
                 iyy="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}" iyz="0.0"
                 izz="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_pos} 0.0 ${-wheel_radius + caster_radius}" rpy="0.0 0.0 0.0" />
    </joint>
  </xacro:macro>

  <xacro:caster_wheel prefix="front" x_pos="${caster_offset_x}" />
  <xacro:caster_wheel prefix="rear" x_pos="${-caster_offset_x}" />

  <!-- ======================================================================== -->
  <!-- RPLIDAR A1M8 Link & Joint                                                -->
  <!-- ======================================================================== -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.038" length="0.04" />
      </geometry>
      <material name="dark_gray" />
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.038" length="0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_frame" />
    <origin xyz="0.18 0.0 ${chassis_height + 0.02}" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- MPU6050 IMU Link & Joint                                                 -->
  <!-- ======================================================================== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.025 0.015 0.005" />
      </geometry>
      <material name="gold" />
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Holybro NEO-M9N GPS Antenna Link & Mast Joint                            -->
  <!-- ======================================================================== -->
  <link name="gps_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.030" length="0.015" />
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="-0.15 0.0 ${chassis_height + 0.20}" rpy="0.0 0.0 0.0" />
  </joint>

</robot>
